# Grafana Cloud Configuration
# Copy to .env and set your actual API key

# Grafana Metrics (Prometheus)
GRAFANA_METRICS_URL=https://prometheus-prod-49-prod-ap-northeast-0.grafana.net/api/prom/push
GRAFANA_METRICS_ID=2758223

# Grafana Logs (Loki)
GRAFANA_LOGS_URL=https://logs-prod-030.grafana.net/loki/api/v1/push
GRAFANA_LOGS_ID=1374788

# Grafana API Key (use your actual key from Grafana Cloud)
GRAFANA_API_KEY=glc_YOUR_API_KEY_HERE

